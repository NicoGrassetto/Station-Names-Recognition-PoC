# Copy this file to .env for local development if you are not using azd hooks:
#   cp .example.env .env
#
# Authentication is handled by DefaultAzureCredential. Run `azd auth login`
# or `az login` with an identity that has the RBAC roles provisioned by infra/.

# Required for the backend GPT Realtime provider.
# For AI Services / Foundry resources, use the endpoint from:
#   az cognitiveservices account show --resource-group <rg> --name <name> --query properties.endpoint -o tsv
AZURE_OPENAI_ENDPOINT="https://<your-ai-services-resource>.cognitiveservices.azure.com/"

# Optional for the backend GPT Realtime provider.
AZURE_OPENAI_DEPLOYMENT="gpt-realtime-1-5"
AZURE_AI_RESOURCE_NAME="<ai-services-resource-name>"

# Required when using destination custom Speech transcription.
AZURE_SPEECH_REGION="<azure-region>"
AZURE_SUBSCRIPTION_ID="<subscription-id>"
AZURE_RESOURCE_GROUP="<resource-group-name>"
AZURE_SPEECH_RESOURCE_NAME="<speech-resource-name>"

# Optional, but recommended for custom Speech training with AAD/custom subdomain.
AZURE_SPEECH_ENDPOINT="https://<your-speech-resource>.cognitiveservices.azure.com/"

# Required only for scripts/train_custom_speech.py.
AZURE_STORAGE_ACCOUNT="<storage-account-name>"
AZURE_STORAGE_CONTAINER="speech-training"

# Optional application settings.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000"
MAX_SESSIONS="10"
CONVERSATION_PROVIDER="gpt-realtime"
CUSTOM_SPEECH_PROJECT="station-names"
